{
  "name": "odea/local-odea",
  "description": "Dev-only lint toolchain for the local_odea Moodle plugin. The plugin itself has zero runtime dependencies.",
  "license": "GPL-3.0-or-later",
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "odea/moodle-source",
        "version": "5.3.0",
        "description": "Moodle 5.3.0 source for static analysis, without its 45 runtime dependencies.",
        "dist": {
          "type": "zip",
          "url": "https://github.com/moodle/moodle/archive/42622298fe06f9626d988d60b2bf589bd8f850e8.zip",
          "reference": "42622298fe06f9626d988d60b2bf589bd8f850e8"
        }
      }
    }
  ],
  "require-dev": {
    "moodlehq/moodle-cs": "3.7.0",
    "odea/moodle-source": "5.3.0",
    "phpstan/phpstan": "2.1.17"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
