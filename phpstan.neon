parameters:
    level: 6
    paths:
        - classes
        - db
        - index.php
        - settings.php
        - version.php
    # Moodle core is not part of this repository. Composer installs the Moodle
    # 5.3.0 source (composer.json), and PHPStan reads its symbols from there
    # without running it. 5.3 is the newest supported version and has both
    # user_create_user() and \core\user::create_user().
    scanDirectories:
        - vendor/odea/moodle-source/public
    scanFiles:
        - tools/phpstan-legacy-names.stub
    treatPhpDocTypesAsCertain: false
    # Moodle injects globals into entry scripts ($CFG, $OUTPUT, $PAGE, $USER,
    # $ADMIN, $plugin, $hassiteconfig) — invisible to PHPStan. Scoped to the
    # entry files only; classes/ gets no such pass.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Moodle types this parameter with the old global name `context`, an
        # alias of \core\context that PHPStan cannot follow (see scanFiles).
        -
            message: '#expects context, core\\context\\system given#'
            path: classes/connector.php
        -
            identifier: variable.undefined
            paths:
                - index.php
                - settings.php
                - version.php
